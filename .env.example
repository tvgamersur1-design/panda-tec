# ─────────────────────────────────────────────────────────────────────────────
# Sistema de Gestión Panta Tec — Variables de Entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# URI de conexión a MongoDB Atlas (incluye usuario, contraseña y nombre de BD)
# Ejemplo: mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/pantatec
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<nombre_bd>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Cadena aleatoria de mínimo 32 caracteres para firmar los tokens JWT.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_de_minimo_32_caracteres

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Credenciales del panel de Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── API RENIEC ────────────────────────────────────────────────────────────────
# URL base del servicio de consulta de DNI y clave de acceso
RENIEC_API_URL=https://api.ejemplo.com/reniec
RENIEC_API_KEY=tu_clave_reniec

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto en el que escucha el servidor Express (por defecto 3000)
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma si hay más de uno)
# Ejemplo producción: https://pantatec.com,https://www.pantatec.com
# IMPORTANTE: En producción, cambia esto por tu dominio real
ALLOWED_ORIGINS=http://localhost:3000

# ── Gmail SMTP (recuperación de contraseña) ──────────────────────────────────
# Correo Gmail desde el cual se envían los emails
GMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicación (NO la contraseña normal de Gmail)
# Generar en: https://myaccount.google.com/apppasswords
# IMPORTANTE: En producción, asegúrate de que estas variables estén configuradas
# y que el servidor permita conexiones salientes al puerto 587 (SMTP)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Client ID de Google Cloud Console (APIs & Services → Credentials → OAuth 2.0)
# Crear en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
